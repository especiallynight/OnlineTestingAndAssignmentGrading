{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/StudentStatistics/{studentId}/{courseId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "analytics-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/analytics/{studentId}/{courseId}",
      "UpstreamHttpMethod": [ "Get" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }

}