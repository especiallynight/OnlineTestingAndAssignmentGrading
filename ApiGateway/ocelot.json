{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/analytics/students/{studentId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "analytics-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/analytics/students/{studentId}",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/analytics/courses/{courseId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "analytics-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/analytics/courses/{courseId}",
      "UpstreamHttpMethod": [ "Get" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8080"
  }
}