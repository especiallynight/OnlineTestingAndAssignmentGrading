@{
    ViewData["Title"] = "Онлайн-тестирование";
}

<div class="text-center">
    <h1 class="display-4">Система онлайн-тестирования</h1>
    <p>Добро пожаловать! Используйте панель ниже для входа и прохождения тестов.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-body">
                <h3>Авторизация</h3>
                <div class="mb-3">
                    <label>Email:</label>
                    <input type="email" id="emailInput" class="form-control" value="student@test.com" />
                </div>
                <div class="mb-3">
                    <label>Пароль:</label>
                    <input type="password" id="passwordInput" class="form-control" value="ExamplePassword123" />
                </div>
                <button id="loginBtn" class="btn btn-primary w-100">Войти</button>
                <div id="tokenResult" class="mt-3 text-break text-success"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
}